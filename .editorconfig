# EditorConfig 统一编辑器配置
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 120

[*.{js,ts,jsx,tsx,vue}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.{html,css,scss,less}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
